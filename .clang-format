---
# Start from LLVM's style and override only what differs below.
BasedOnStyle: LLVM

# clang-format uses "Cpp" for C, C++ and Objective-C files alike.
Language: Cpp

# Indent with 4 spaces, never tab characters, so the code looks the
# same in every editor.
IndentWidth: 4
TabWidth: 4
UseTab: Never

# Wrap lines longer than 100 characters. Long index expressions such as
# A->mat[i * A->cols + k] fit on one line more often than at LLVM's 80.
ColumnLimit: 100

# Opening braces stay on the same line as the if, for or function.
# (Also LLVM's default; listed to make the choice explicit.)
BreakBeforeBraces: Attach

# The * sits next to the name, not the type: Matrix *P, float *mat.
# (Also LLVM's default.) This matches how C parses a declaration like
# float *a, b; where only a is a pointer.
PointerAlignment: Right

# Short functions whose body fits on one line are joined onto it, e.g.
#   float relu_deriv(float x) { return x > 0.0f ? 1.0f : 0.0f; }
# Longer functions are left on several lines.
AllowShortFunctionsOnASingleLine: All

# Never put an if, loop or case body on the same line as its condition,
# so every body is visible at a glance and easy to set a breakpoint on.
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never

# Sort #include lines alphabetically within each block. A blank line
# starts a new block, so keep your own headers and the system headers
# (<stdio.h>, <math.h>, ...) in separate blocks. A file's own header,
# e.g. layer.h in layer.c, is always kept first.
SortIncludes: CaseSensitive
IncludeBlocks: Preserve
...
